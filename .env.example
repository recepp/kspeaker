API_BASE_URL=https://kartezya-ai.up.railway.app

# ElevenLabs key belongs on Railway Variables (NOT in the mobile app):
#   ELEVENLABS_API_KEY=sk_...
#   ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   (optional)
#
# Mobile calls POST /tts { provider: "elevenlabs", text, language }
# See server-examples/elevenlabsTtsRoute.js

# Optional: override default voice id sent to backend
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
